{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "default",
    "disableBypassPermissionsMode": "disable",
    "blockReadsOutsideWorkingDirectories": true,
    "allow": [
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch)",
      "Bash(git branch --show-current)",
      "Bash(git blame *)",
      "Bash(git rev-parse *)",
      "Bash(npm run test)",
      "Bash(npm run test *)",
      "Bash(npm test)",
      "Bash(npm test *)",
      "Bash(npm run lint)",
      "Bash(npm run lint *)",
      "Bash(npm run typecheck)",
      "Bash(npm run build)",
      "Bash(npx tsc --noEmit)",
      "Bash(pytest)",
      "Bash(pytest *)",
      "Bash(python -m pytest *)",
      "Bash(python3 -m pytest *)",
      "Bash(ruff check *)",
      "Bash(ruff format --check *)",
      "Bash(mypy *)",
      "Bash(go test ./...)",
      "Bash(go vet ./...)",
      "Bash(pre-commit run)",
      "Bash(pre-commit run --all-files)",
      "Bash(terraform fmt -check *)",
      "Bash(terraform validate)",
      "Bash(python3 scripts/claude_safeguard.py scan *)",
      "Bash(python3 scripts/claude_safeguard.py check-output *)",
      "mcp__internal-docs__*"
    ],
    "ask": [
      "WebFetch",
      "Bash(git push *)",
      "Bash(git reset *)",
      "Bash(git rebase *)",
      "Bash(npm install *)",
      "Bash(npm ci *)",
      "Bash(npx *)",
      "Bash(pip install *)",
      "Bash(pip3 install *)",
      "Bash(uv add *)",
      "Bash(poetry add *)",
      "Bash(go get *)",
      "Bash(terraform plan *)",
      "Bash(terraform init *)",
      "Bash(docker *)",
      "Bash(kubectl *)",
      "Bash(helm *)",
      "Bash(aws *)",
      "Bash(gcloud *)",
      "Bash(az *)",
      "Bash(gh *)",
      "Bash(rm *)",
      "Bash(chmod *)",
      "mcp__internal-tickets__*",
      "Edit(**/*.tf)",
      "Edit(**/*.tfvars)",
      "Edit(**/*.hcl)",
      "Edit(**/Dockerfile*)",
      "Edit(**/.github/workflows/**)",
      "Edit(**/k8s/**)",
      "Edit(**/helm/**)",
      "Edit(**/auth/**)",
      "Edit(**/security/**)",
      "Edit(**/crypto/**)",
      "Edit(/.claude/**)",
      "Edit(/.mcp.json)",
      "Edit(/CLAUDE.md)",
      "Edit(/.pre-commit-config.yaml)",
      "Edit(/.github/CODEOWNERS)",
      "Edit(/scripts/claude_safeguard.py)",
      "Edit(/scripts/precommit/**)",
      "Edit(/config/claude-guardrails-policy.json)",
      "Edit(/enterprise/**)",
      "Edit(/docs/claude-guardrails.md)",
      "Edit(/docs/claude-guardrails-setup.md)",
      "Edit(/scripts/setup_guardrails.sh)",
      "Edit(/pyproject.toml)",
      "Edit(/.gitignore)"
    ],
    "deny": [
      "WebSearch",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(nc *)",
      "Bash(ncat *)",
      "Bash(netcat *)",
      "Bash(telnet *)",
      "Bash(socat *)",
      "Bash(ssh *)",
      "Bash(scp *)",
      "Bash(sftp *)",
      "Bash(ftp *)",
      "Bash(sudo *)",
      "Bash(su *)",
      "Bash(printenv)",
      "Bash(printenv *)",
      "Bash(env)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git commit --no-verify *)",
      "Bash(git push --no-verify *)",
      "Bash(terraform apply)",
      "Bash(terraform apply *)",
      "Bash(terraform destroy)",
      "Bash(terraform destroy *)",
      "Bash(kubectl delete *)",
      "Bash(npm publish *)",
      "Bash(docker push *)",
      "Bash(twine upload *)",
      "Read(./.env)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.development)",
      "Read(**/.env.staging)",
      "Read(**/.env.production)",
      "Read(**/.env.test)",
      "Read(**/.env.*.local)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.p12)",
      "Read(**/*.pfx)",
      "Read(**/id_rsa*)",
      "Read(**/id_ed25519*)",
      "Read(**/*.tfstate)",
      "Read(**/*.tfstate.backup)",
      "Read(**/secrets/**)",
      "Read(**/credentials.json)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.azure/**)",
      "Read(~/.config/gcloud/**)",
      "Read(~/.kube/**)",
      "Read(~/.docker/config.json)",
      "Read(~/.netrc)",
      "Read(~/.npmrc)",
      "Read(~/.pypirc)",
      "Read(~/.git-credentials)",
      "Edit(**/.env)",
      "Edit(**/.env.local)",
      "Edit(**/.env.production)",
      "Edit(**/*.pem)",
      "Edit(**/*.key)"
    ]
  },
  "enableAllProjectMcpServers": false,
  "enabledMcpjsonServers": [
    "internal-docs",
    "internal-tickets"
  ],
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": false,
    "allowUnsandboxedCommands": false,
    "excludedCommands": [],
    "network": {
      "allowedDomains": [
        "github.com",
        "registry.npmjs.org",
        "pypi.org",
        "files.pythonhosted.org",
        "proxy.golang.org",
        "artifacts.internal.example.com"
      ]
    },
    "filesystem": {
      "denyRead": [
        "~/.ssh",
        "~/.aws",
        "~/.azure",
        "~/.config/gcloud",
        "~/.kube",
        "~/.docker/config.json",
        "~/.netrc",
        "~/.npmrc",
        "~/.pypirc",
        "~/.git-credentials",
        "~/.gnupg"
      ]
    }
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/.claude/hooks/prompt_guard.py\"",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Monitor",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/.claude/hooks/bash_guard.py\"",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/.claude/hooks/file_guard.py\"",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Read|Grep|Glob|NotebookRead",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/.claude/hooks/read_guard.py\"",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "cleanupPeriodDays": 14
}
